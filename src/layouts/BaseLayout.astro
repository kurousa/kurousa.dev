---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile, siteMeta } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = siteMeta.title,
  description = siteMeta.description,
  path = '/',
} = Astro.props;

const canonicalUrl = new URL(path, siteMeta.url).toString();
const navItems = [
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Articles', href: '/#articles' },
  { label: 'Links', href: '/#links' },
];
---

<!doctype html>
<html lang="ja" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteMeta.author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="kurousa.dev" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Prevent dark/light theme FOUC; default is dark -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header
      class="sticky top-0 z-50 border-b border-slate-200/80 bg-slate-50/85 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-950/85"
    >
      <div class="mx-auto flex h-16 max-w-4xl items-center justify-between px-6">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 text-base font-semibold tracking-tight text-slate-900 transition-colors hover:text-sky-600 dark:text-slate-100 dark:hover:text-sky-400"
        >
          <span
            class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-slate-900 text-xs font-bold text-sky-400 ring-1 ring-slate-700/80 dark:bg-slate-900"
            aria-hidden="true"
          >
            k
          </span>
          <span>kurousa.dev</span>
        </a>

        <div class="flex items-center gap-2 sm:gap-5">
          <nav aria-label="メインナビゲーション" class="hidden sm:flex items-center gap-5">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-950 dark:text-slate-400 dark:hover:text-slate-100"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <ThemeToggle />
        </div>
      </div>

      <nav
        aria-label="モバイルナビゲーション"
        class="flex sm:hidden items-center justify-around border-t border-slate-200/60 px-4 py-2 text-xs font-medium text-slate-600 dark:border-slate-800/60 dark:text-slate-400"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="px-2 py-1 transition-colors hover:text-slate-950 dark:hover:text-slate-100"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-12 sm:py-16">
      <slot />
    </main>

    <footer class="border-t border-slate-200/80 py-8 dark:border-slate-800/80">
      <div
        class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-4 px-6 text-sm text-slate-500 sm:flex-row dark:text-slate-400"
      >
        <p>&copy; {new Date().getFullYear()} {profile.name}</p>
        <div class="flex items-center gap-5">
          {
            profile.links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-slate-900 dark:hover:text-slate-100"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </footer>
  </body>
</html>
