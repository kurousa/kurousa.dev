---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ArticlesSection from '../components/ArticlesSection.astro';
import { profile } from '../data/profile';
import { fetchZennArticles } from '../lib/zenn';

const projects = await getCollection('projects');
const { articles, failed } = await fetchZennArticles(profile.zennFeedUrl, 6);
---

<BaseLayout>
  <Hero />
  <About />
  <ProjectsSection projects={projects} />
  <ArticlesSection
    articles={articles}
    failed={failed}
    profileUrl={profile.zennProfileUrl}
  />

  <section id="links" class="border-t border-slate-200/80 py-14 sm:py-16 dark:border-slate-800/80">
    <div class="flex items-baseline justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
        Links
      </h2>
      <span class="text-xs font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Connect
      </span>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        profile.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-5 transition-colors hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800/90 dark:bg-slate-900/60 dark:hover:border-slate-700 dark:hover:bg-slate-800/50"
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="text-base font-semibold text-slate-900 transition-colors group-hover:text-sky-600 dark:text-slate-100 dark:group-hover:text-sky-400">
                  {link.label}
                </span>
                <span
                  class="text-sm text-slate-400 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-sky-500 dark:text-slate-500 dark:group-hover:text-sky-400"
                  aria-hidden="true"
                >
                  &#8599;
                </span>
              </div>
              <p class="mt-1 text-xs font-mono text-slate-500 dark:text-slate-400">
                {link.handle}
              </p>
            </div>
            <p class="mt-3 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              {link.description}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
