---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const sortedProjects = [...projects].sort((a, b) => {
  if (a.data.order !== b.data.order) {
    return a.data.order - b.data.order;
  }
  return b.data.date.getTime() - a.data.date.getTime();
});
---

<section id="projects" class="border-t border-slate-200/80 py-14 sm:py-16 dark:border-slate-800/80">
  <div class="flex items-baseline justify-between">
    <h2 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
      Projects
    </h2>
    <span class="text-xs font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500">
      Selected Works
    </span>
  </div>

  <div class="mt-8 grid gap-6">
    {
      sortedProjects.map((project) => (
        <article class="group rounded-2xl border border-slate-200/90 bg-white p-6 transition-colors hover:border-slate-300 dark:border-slate-800/90 dark:bg-slate-900/60 dark:hover:border-slate-700">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-3">
              <h3 class="text-xl font-semibold tracking-tight text-slate-950 dark:text-white">
                <a
                  href={`/projects/${project.id}`}
                  class="transition-colors hover:text-sky-600 dark:hover:text-sky-400"
                >
                  {project.data.title}
                </a>
              </h3>
              {project.data.featured && (
                <span class="inline-flex items-center rounded-full border border-sky-500/25 bg-sky-500/10 px-2.5 py-0.5 text-xs font-medium text-sky-700 dark:border-sky-400/25 dark:bg-sky-400/10 dark:text-sky-300">
                  Featured
                </span>
              )}
            </div>
          </div>

          <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base dark:text-slate-300">
            {project.data.summary}
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            {project.data.tech.map((item) => (
              <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 dark:border-slate-700/80 dark:bg-slate-800/80 dark:text-slate-200">
                {item}
              </span>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-slate-100 pt-4 text-sm font-medium dark:border-slate-800/80">
            <a
              href={`/projects/${project.id}`}
              class="inline-flex items-center gap-1 text-sky-600 transition-colors hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
            >
              <span>詳細を見る</span>
              <span aria-hidden="true">&rarr;</span>
            </a>

            {project.data.githubUrl && (
              <a
                href={project.data.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-slate-600 transition-colors hover:text-slate-950 dark:text-slate-400 dark:hover:text-white"
              >
                <span>GitHub</span>
                <span aria-hidden="true" class="text-xs">&#8599;</span>
              </a>
            )}

            {project.data.articleUrl && (
              <a
                href={project.data.articleUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-slate-600 transition-colors hover:text-slate-950 dark:text-slate-400 dark:hover:text-white"
              >
                <span>Zenn解説記事</span>
                <span aria-hidden="true" class="text-xs">&#8599;</span>
              </a>
            )}

            {project.data.demoUrl && (
              <a
                href={project.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-slate-600 transition-colors hover:text-slate-950 dark:text-slate-400 dark:hover:text-white"
              >
                <span>Demo</span>
                <span aria-hidden="true" class="text-xs">&#8599;</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
