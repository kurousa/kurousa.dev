---
import type { ZennArticle } from '../lib/zenn';

interface Props {
  articles: ZennArticle[];
  failed: boolean;
  profileUrl: string;
}

const { articles, failed, profileUrl } = Astro.props;
---

<section id="articles" class="border-t border-slate-200/80 py-14 sm:py-16 dark:border-slate-800/80">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
        Articles
      </h2>
      <p class="mt-1 text-xs font-mono text-slate-500 dark:text-slate-400">
        Zenn (@user_thebigslee)
      </p>
    </div>

    <a
      href={profileUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-sm font-medium text-sky-600 transition-colors hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
    >
      <span>Zennで一覧を見る</span>
      <span aria-hidden="true">&#8599;</span>
    </a>
  </div>

  {
    failed || articles.length === 0 ? (
      <div class="mt-8 rounded-2xl border border-slate-200/90 bg-white p-6 text-sm text-slate-600 dark:border-slate-800/90 dark:bg-slate-900/60 dark:text-slate-300">
        <p class="leading-relaxed">
          {failed
            ? '現在、ZennのRSSフィードから最新記事を読み込めませんでした。記事一覧はZennプロフィールページからご覧いただけます。'
            : '公開中の記事はまだありません。'}
        </p>
        <a
          href={profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3.5 py-2 text-sm font-medium text-slate-800 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700"
        >
          <span>Zennプロフィールを開く</span>
          <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    ) : (
      <div class="mt-8 divide-y divide-slate-200/80 overflow-hidden rounded-2xl border border-slate-200/90 bg-white dark:divide-slate-800/80 dark:border-slate-800/90 dark:bg-slate-900/60">
        {articles.map((article) => (
          <a
            href={article.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group block p-5 transition-colors hover:bg-slate-50 sm:p-6 dark:hover:bg-slate-800/40"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                {article.formattedDate && (
                  <time
                    datetime={article.pubDate}
                    class="block text-xs font-mono text-slate-500 dark:text-slate-400"
                  >
                    {article.formattedDate}
                  </time>
                )}
                <h3 class="mt-1.5 text-base font-semibold leading-snug text-slate-900 transition-colors group-hover:text-sky-600 sm:text-lg dark:text-slate-100 dark:group-hover:text-sky-400">
                  {article.title}
                </h3>
                {article.excerpt && (
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                    {article.excerpt}
                  </p>
                )}
              </div>
              <span
                class="mt-1 shrink-0 text-sm text-slate-400 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-sky-500 dark:text-slate-500 dark:group-hover:text-sky-400"
                aria-hidden="true"
              >
                &#8599;
              </span>
            </div>
          </a>
        ))}
      </div>
    )
  }
</section>
