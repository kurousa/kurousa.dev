---
import { profile } from '../data/profile';
---

<section id="about" class="border-t border-slate-200/80 py-14 sm:py-16 dark:border-slate-800/80">
  <div class="flex items-baseline justify-between">
    <h2 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
      About
    </h2>
    <span class="text-xs font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500">
      Profile &amp; Stack
    </span>
  </div>

  <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600 dark:text-slate-300">
    {profile.about}
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    {
      profile.interests.map((item) => (
        <div class="rounded-xl border border-slate-200/90 bg-white p-5 dark:border-slate-800/90 dark:bg-slate-900/60">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
            {item.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            {item.description}
          </p>
        </div>
      ))
    }
  </div>

  <div class="mt-10 rounded-xl border border-slate-200/90 bg-white p-6 dark:border-slate-800/90 dark:bg-slate-900/60">
    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
      技術スタック
    </h3>
    <div class="mt-4 space-y-3.5">
      {
        profile.skills.map((group) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
            <span class="w-32 shrink-0 text-xs font-mono font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">
              {group.category}
            </span>
            <div class="flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 dark:border-slate-700/80 dark:bg-slate-800/80 dark:text-slate-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
